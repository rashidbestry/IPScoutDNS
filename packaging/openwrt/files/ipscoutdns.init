#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/ipscoutdns
CONFIG=/etc/ipscoutdns.conf

start_service() {
	[ -x "$PROG" ] || {
		echo "IPScoutDNS binary is missing or not executable: $PROG" >&2
		return 1
	}
	[ -r "$CONFIG" ] || {
		echo "IPScoutDNS config is not readable: $CONFIG" >&2
		return 1
	}
	mkdir -p /tmp/ipscoutdns || return 1
	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG"
	# procd restarts the process on reload when these files change.
	procd_set_param file "$CONFIG" /etc/ipscoutdns/active-domains.txt /etc/ipscoutdns/passive-domains.txt
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
